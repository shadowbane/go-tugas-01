### --------------------------------------------
### ERROR CASES
### --------------------------------------------

### 5. Checkout with empty cart (400)
POST {{host}}/api/checkout
Content-Type: application/json

{
    "items": []
}

> {%
    client.test("POST /checkout (empty cart) - Status is 400", function() {
        client.assert(response.status === 400, "Expected 400 for empty cart");
    });

    client.test("POST /checkout (empty cart) - Success is false", function() {
        client.assert(response.body.success === false, "Expected success to be false");
    });

    client.test("POST /checkout (empty cart) - Error message", function() {
        client.assert(response.body.data.message === "cart is empty", "Expected 'cart is empty' message");
    });
%}

###

### 6. Checkout with invalid quantity (0)
POST {{host}}/api/checkout
Content-Type: application/json

{
    "items": [
        {"product_id": "{{checkoutProductA}}", "quantity": 0}
    ]
}

> {%
    client.test("POST /checkout (quantity 0) - Status is 400", function() {
        client.assert(response.status === 400, "Expected 400 for invalid quantity");
    });

    client.test("POST /checkout (quantity 0) - Error message", function() {
        client.assert(response.body.data.message === "quantity must be greater than 0", "Expected quantity error");
    });
%}

###

### 7. Checkout with negative quantity
POST {{host}}/api/checkout
Content-Type: application/json

{
    "items": [
        {"product_id": "{{checkoutProductA}}", "quantity": -5}
    ]
}

> {%
    client.test("POST /checkout (negative quantity) - Status is 400", function() {
        client.assert(response.status === 400, "Expected 400 for negative quantity");
    });
%}

###

### 8. Checkout with non-existent product (404)
POST {{host}}/api/checkout
Content-Type: application/json

{
    "items": [
        {"product_id": "01NONEXISTENT00000000000", "quantity": 1}
    ]
}

> {%
    client.test("POST /checkout (non-existent product) - Status is 404", function() {
        client.assert(response.status === 404, "Expected 404 for non-existent product");
    });

    client.test("POST /checkout (non-existent product) - Success is false", function() {
        client.assert(response.body.success === false, "Expected success to be false");
    });
%}

###

### 9. Checkout with insufficient stock (400)
POST {{host}}/api/checkout
Content-Type: application/json

{
    "items": [
        {"product_id": "{{checkoutProductA}}", "quantity": 9999}
    ]
}

> {%
    client.test("POST /checkout (insufficient stock) - Status is 400", function() {
        client.assert(response.status === 400, "Expected 400 for insufficient stock");
    });

    client.test("POST /checkout (insufficient stock) - Error message", function() {
        client.assert(response.body.data.message === "insufficient stock", "Expected 'insufficient stock' message");
    });
%}

###

### 10. Verify stock unchanged after failed checkout
GET {{host}}/api/products/{{checkoutProductA}}
Content-Type: application/json

> {%
    client.test("GET /products - Stock unchanged after failed checkout", function() {
        client.assert(response.body.data.stock === 45, "Expected stock still 45");
    });
%}

