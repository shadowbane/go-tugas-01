### Delete a category
DELETE {{host}}/api/categories/{{categoryId}}
Content-Type: application/json

> {%
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Response is successful", function() {
        client.assert(response.body.success === true, "Expected success to be true");
    });

    client.test("Delete message returned", function() {
        client.assert(response.body.data.message === "Category deleted", "Expected deletion message");
    });
%}

###
