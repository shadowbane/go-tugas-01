### --------------------------------------------
### CATEGORY TESTS
### --------------------------------------------

### 1. Create Category (Success)
POST {{host}}/categories
Content-Type: application/json

{
    "name": "Test Category",
    "description": "Category for testing purposes"
}

> {%
    client.test("POST /categories - Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("POST /categories - Response is successful", function() {
        client.assert(response.body.success === true, "Expected success to be true");
    });

    client.test("POST /categories - Category has ULID", function() {
        client.assert(response.body.data.id !== undefined && response.body.data.id.length === 26, "Expected 26-char ULID");
    });

    client.test("POST /categories - Name matches", function() {
        client.assert(response.body.data.name === "Test Category", "Expected name 'Test Category'");
    });

    client.global.set("testCategoryId", response.body.data.id);
%}

###

### 2. Create Second Category (for additional tests)
POST {{host}}/categories
Content-Type: application/json

{
    "name": "Second Category",
    "description": "Another category for testing"
}

> {%
    client.test("POST /categories - Create second category", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.global.set("secondCategoryId", response.body.data.id);
%}

###

### 3. Get All Categories
GET {{host}}/categories
Content-Type: application/json

> {%
    client.test("GET /categories - Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("GET /categories - Response is successful", function() {
        client.assert(response.body.success === true, "Expected success to be true");
    });

    client.test("GET /categories - Data is an array", function() {
        client.assert(Array.isArray(response.body.data), "Expected data to be an array");
    });

    client.test("GET /categories - Array has items", function() {
        client.assert(response.body.data.length >= 2, "Expected at least 2 categories");
    });
%}

###

### 4. Get Single Category (Success)
GET {{host}}/categories/{{testCategoryId}}
Content-Type: application/json

> {%
    client.test("GET /categories/:id - Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("GET /categories/:id - Correct category returned", function() {
        client.assert(response.body.data.id === client.global.get("testCategoryId"), "Expected correct category ID");
    });

    client.test("GET /categories/:id - Name matches", function() {
        client.assert(response.body.data.name === "Test Category", "Expected name 'Test Category'");
    });
%}

###

### 5. Get Non-Existent Category (404)
