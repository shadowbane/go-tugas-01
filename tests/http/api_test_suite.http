### 16. Get Single Product (Success)
GET {{host}}/products/{{testProductId}}
Content-Type: application/json

> {%
    client.test("GET /products/:id - Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("GET /products/:id - Correct product returned", function() {
        client.assert(response.body.data.id === client.global.get("testProductId"), "Expected correct product ID");
    });

    client.test("GET /products/:id - Name matches", function() {
        client.assert(response.body.data.name === "Test Product", "Expected name 'Test Product'");
    });

    client.test("GET /products/:id - Has all required fields", function() {
        const data = response.body.data;
        client.assert(data.id !== undefined, "Expected id field");
        client.assert(data.category_id !== undefined, "Expected category_id field");
        client.assert(data.name !== undefined, "Expected name field");
        client.assert(data.description !== undefined, "Expected description field");
        client.assert(data.price !== undefined, "Expected price field");
        client.assert(data.stock !== undefined, "Expected stock field");
    });
%}

