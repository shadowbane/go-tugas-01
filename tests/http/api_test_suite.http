### --------------------------------------------
### PRODUCT TESTS
### --------------------------------------------

### 11. Create Product (Success)
POST {{host}}/products
Content-Type: application/json

{
    "category_id": "{{testCategoryId}}",
    "name": "Test Product",
    "description": "Product for testing",
    "price": 10000,
    "stock": 50
}

> {%
    client.test("POST /products - Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("POST /products - Response is successful", function() {
        client.assert(response.body.success === true, "Expected success to be true");
    });

    client.test("POST /products - Product has ULID", function() {
        client.assert(response.body.data.id !== undefined && response.body.data.id.length === 26, "Expected 26-char ULID");
    });

    client.test("POST /products - Name matches", function() {
        client.assert(response.body.data.name === "Test Product", "Expected name 'Test Product'");
    });

    client.test("POST /products - Price matches", function() {
        client.assert(response.body.data.price === 10000, "Expected price 10000");
    });

    client.test("POST /products - Stock matches", function() {
        client.assert(response.body.data.stock === 50, "Expected stock 50");
    });

    client.test("POST /products - category_id (FK) matches", function() {
        client.assert(response.body.data.category_id === client.global.get("testCategoryId"), "Expected category_id to match category");
    });

    client.global.set("testProductId", response.body.data.id);
%}

###

### 12. Create Product with Non-Existent Category ID (Should Fail - FK Constraint)
POST {{host}}/products
Content-Type: application/json

{
    "category_id": "01NONEXISTENT00000000000",
    "name": "Invalid Product",
    "description": "This should fail",
    "price": 5000,
    "stock": 10
}

> {%
    client.test("POST /products (invalid FK) - Status is 500 (FK violation)", function() {
        client.assert(response.status === 500, "Expected 500 for FK constraint violation");
    });

    client.test("POST /products (invalid FK) - Success is false", function() {
        client.assert(response.body.success === false, "Expected success to be false");
    });
%}

###

### 13. Create Product with Empty Category ID
POST {{host}}/products
Content-Type: application/json

{
    "category_id": "",
    "name": "No Category Product",
    "description": "Product without category",
    "price": 3000,
    "stock": 5
}

> {%
    client.test("POST /products (empty FK) - Status is not 200 or handles gracefully", function() {
        // Depending on DB constraints, this might be 500 (FK violation) or 200 (if nullable)
        client.assert(response.status === 500 || response.status === 200, "Expected 500 or 200");
    });
%}

